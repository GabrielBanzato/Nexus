# Copie para .env e ajuste. Usado pelo docker-compose e pelo backend rodando fora do Docker.
# NUNCA coloque valores reais neste arquivo: ele é versionado no Git.

# --- MySQL ---------------------------------------------------------------
MYSQL_ROOT_PASSWORD=troque-esta-senha-root
MYSQL_DATABASE=nexus
MYSQL_USER=nexus
MYSQL_PASSWORD=troque-esta-senha

# Apenas para rodar o backend fora do Docker (npm run dev).
# No docker-compose o MySQL é publicado no host na porta 3307.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307

# --- Servidor -------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# --- Autenticação ---------------------------------------------------------
# Primeiro admin (criado no arranque só se não existir nenhum utilizador).
ADMIN_EMAIL=admin@nexus.local
ADMIN_NAME=Administrador
ADMIN_PASSWORD=troque-esta-senha-do-painel
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h

# --- Cloudflare Tunnel ----------------------------------------------------
# Zero Trust > Networks > Tunnels > (seu túnel) > token de instalação
CLOUDFLARE_TUNNEL_TOKEN=

# --- Scraper --------------------------------------------------------------
SCRAPER_HEADLESS=true
SCRAPER_MAX_RESULTS=50

# --- WhatsApp (whatsapp-web.js, não oficial) -------------------------------
# true (padrão no Docker): sobe um Chrome com o WhatsApp Web; o admin lê o QR em Equipe → WhatsApp.
WHATSAPP_ENABLED=true
# Número desconhecido escreve: cria um cliente "lead" (true) ou ignora (false).
WHATSAPP_AUTO_CREATE_CLIENTS=true
# Fora do Docker: pasta da sessão (fica fora do Git) e false para ver o navegador.
# No Windows use uma pasta de caminho CURTO (até 100 caracteres, ex.: C:\nexus-whatsapp):
# o Chrome grava ~150 caracteres abaixo dela e o Windows limita caminhos a 260.
# WHATSAPP_SESSION_DIR=.wwebjs_auth
# WHATSAPP_HEADLESS=true

# Fuso da empresa (datas nas mensagens aos clientes, ex.: confirmação de reunião).
BUSINESS_TIMEZONE=America/Sao_Paulo

# --- Videochamadas na plataforma (WebRTC P2P, até 3 pessoas) ----------------
# Endereço público do painel (o que o cliente abre). Usado no link enviado por WhatsApp
# ao agendar a reunião. Sem ele, a confirmação vai sem link.
PUBLIC_APP_URL=https://nexus.suaempresa.com.br
# Relé TURN (coturn): para quem está em rede que bloqueia vídeo direto. Ligue com o perfil
# "meet" (ex.: COMPOSE_PROFILES=ai,meet) e abra no firewall da VPS: 3478/udp, 3478/tcp e
# 49160-49200/udp. Use o IP da VPS (o Cloudflare Tunnel não leva tráfego de vídeo).
# Gere o segredo com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TURN_SECRET=
# TURN_URLS=turn:IP_DA_VPS:3478?transport=udp,turn:IP_DA_VPS:3478?transport=tcp
# MEET_MAX_PARTICIPANTS=3

# --- Assistente de IA (Qwen local via Ollama) -------------------------------
# Sugere respostas na Central de Atendimento (nunca envia sozinho). Precisa do WhatsApp ligado.
# Para ligar: AI_ENABLED=true E COMPOSE_PROFILES=ai (sobe o container do Ollama).
AI_ENABLED=false
# COMPOSE_PROFILES=ai
# Escolhido por benchmark (CPU, 2 threads): 8/8 nas regras, ~9s/resposta no i7 (≈12–18s no VPS).
# Mais rápido (≈3–5s) mas inventa mais: qwen3:1.7b. NÃO use a tag "qwen3.5:2b" (= q8_0, 2,7 GB).
AI_MODEL=qwen3.5:2b-q4_K_M
# Threads de CPU para gerar: 2 no VPS KVM 2 (2 vCPU).
AI_NUM_THREAD=2
# Fora do Docker: OLLAMA_URL=http://127.0.0.1:11434
# Ajustes finos (padrões): AI_DEBOUNCE_MS=6000  AI_TIMEOUT_MS=90000
