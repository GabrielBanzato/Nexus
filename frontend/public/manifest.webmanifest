{
  "name": "Nexus",
  "short_name": "Nexus",
  "description": "CRM da equipe: prospecção, pipeline, atendimento no WhatsApp e reuniões.",
  "lang": "pt-BR",
  "id": "/",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone"],
  "launch_handler": { "client_mode": ["navigate-existing", "auto"] },
  "prefer_related_applications": false,
  "orientation": "any",
  "background_color": "#0e0e0e",
  "theme_color": "#0e0e0e",
  "categories": ["business", "productivity"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Central de Atendimento", "short_name": "Atendimento", "url": "/#/atendimento", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Pipeline", "url": "/#/pipeline", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Triagem", "url": "/#/triagem", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
